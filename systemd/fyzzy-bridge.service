[Unit]
Description=Fyzzy Bridge (Keiser Hub collector)
After=network-online.target NetworkManager.service fyzzy-enroll.service
Wants=network-online.target
# Ordered after first-boot enroll so the collector uses the enrolled identity.
# A failed/absent enroll does NOT block the collector (only ordering, not a dep).

[Service]
Type=simple
User=fyzzy
WorkingDirectory=/opt/fyzzy-bridge
EnvironmentFile=-/etc/fyzzy-bridge.env
# Runs the single bundled file behind the `current` symlink, which OTA swaps.
ExecStart=/usr/bin/node /opt/fyzzy-bridge/current/bundle.cjs
Restart=always
RestartSec=5
# Provisioning needs to run nmcli; the on-site setup portal binds port 80 (so the
# phone opens http://10.42.0.1 and OS captive-probes hit it) → CAP_NET_BIND_SERVICE.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
